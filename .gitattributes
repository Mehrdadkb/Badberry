# Normalize line endings: LF in the repo, native in the working tree.
* text=auto eol=lf

# Lockfiles and generated manifests
pnpm-lock.yaml -diff linguist-generated

# Binary assets — never normalize or diff as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.ogg binary
*.wav binary
